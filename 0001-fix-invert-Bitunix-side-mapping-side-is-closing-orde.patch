Subject: [PATCH] =?UTF-8?q?fix:=20invert=20Bitunix=20side=20mapping=20?=
 =?UTF-8?q?=E2=80=94=20side=20is=20closing=20order,=20not=20position?=
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Баг: все Bitunix сделки показывались как short, даже LONG-позиции.

Причина: Bitunix /api/v1/futures/position/get_history_positions возвращает
side как сторону ЗАКРЫВАЮЩЕГО ордера, а не направление позиции:
  - LONG позиция закрывается SELL ордером → side=SELL
  - SHORT позиция закрывается BUY ордером → side=BUY

Предыдущий фикс маппил BUY→long / SELL→short — это инверсия.
Теперь маппим правильно:
  - SELL → long (закрыли LONG)
  - BUY → short (закрыли SHORT)

Подтверждение с пользовательских данных:
- Сделка EVAAUSDT вход 1.5375 → выход 2.0987 (цена выросла, PnL +181)
  — явно LONG, но показывалась как Short.
- SQL показал: 2030 сделок с raw_side=BUY, 1042 с raw_side=SELL.
  С новым маппингом: 2030 short, 1042 long — пропорция реалистичная.
---
 lib/exchanges/bitunix.ts | 22 ++++++++++++++++++++--
 1 file changed, 20 insertions(+), 2 deletions(-)

diff --git a/lib/exchanges/bitunix.ts b/lib/exchanges/bitunix.ts
index c766ea0..5681256 100644
--- a/lib/exchanges/bitunix.ts
+++ b/lib/exchanges/bitunix.ts
@@ -27,15 +27,33 @@ interface BitunixPosition {
 
 /**
  * Нормализация side из ответа Bitunix в наш union "long" | "short".
+ *
+ * ВАЖНО: Bitunix /api/v1/futures/position/get_history_positions возвращает
+ * side как сторону ОРДЕРА, которым позиция была ЗАКРЫТА (не открыта).
+ * Это типичное поведение для futures API:
+ *   - LONG позиция закрывается SELL ордером → side=SELL → должно быть "long"
+ *   - SHORT позиция закрывается BUY ордером → side=BUY → должно быть "short"
+ *
+ * Поэтому маппинг ИНВЕРТИРОВАН относительно обычной конвенции BUY=long/SELL=short.
+ *
  * Если значение не распознано — логируем warning и возвращаем "short"
  * (безопасный дефолт), но в raw сохраняется оригинальное значение для отладки.
  */
 function normalizeSide(rawSide: string): "long" | "short" {
   const s = String(rawSide).toUpperCase();
-  if (s === "LONG" || s === "BUY" || s === "1" || s === "OPENLONG" || s === "CLOSELONG") {
+  // SELL = закрыли LONG позицию → long
+  if (s === "SELL" || s === "2" || s === "CLOSELONG") {
+    return "long";
+  }
+  // BUY = закрыли SHORT позицию → short
+  if (s === "BUY" || s === "1" || s === "CLOSESHORT") {
+    return "short";
+  }
+  // Явные LONG/SHORT (если когда-нибудь появятся) — прямое соответствие
+  if (s === "LONG" || s === "OPENLONG") {
     return "long";
   }
-  if (s === "SHORT" || s === "SELL" || s === "2" || s === "OPENSHORT" || s === "CLOSESHORT") {
+  if (s === "SHORT" || s === "OPENSHORT") {
     return "short";
   }
   console.warn(`[bitunix] unknown side value: ${JSON.stringify(rawSide)}, defaulting to short`);
