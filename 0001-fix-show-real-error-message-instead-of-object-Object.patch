From 5b9b17a364ad90e157c2c5a17852a5d6a944be47 Mon Sep 17 00:00:00 2001
From: futures-tracker-fixes <dev@local>
Date: Thu, 30 Jul 2026 16:42:41 +0000
Subject: [PATCH] fix: show real error message instead of [object Object] in
 admin allowlist
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Баг: при добавлении/удалении email в админке показывался красный
'[object Object]' вместо реальной ошибки.

Причина: data.error из API мог быть объектом (например, Supabase
возвращает {message, code, details, hint}), а не строкой. Когда
throw new Error(data.error) получает объект, err.message становится
'[object Object]'.

Фикс — на двух уровнях:

1. API-роуты (POST /api/admin/allowlist, DELETE /api/admin/allowlist/[email]):
   - Если insertError/deleteError — берём insertError.message (строка)
   - Если message пустой — JSON.stringify всей ошибки
   - В catch всегда возвращаем { error: 'строка' }

2. UI (app/admin/page.tsx, addEmail + removeEmail):
   - typeof data.error === 'string' ? data.error
     : data.error ? JSON.stringify(data.error)
     : `HTTP ${res.status}`
   - Гарантированно строка в setError()

Теперь в UI будет видна настоящая ошибка — например,
'permission denied for table allowed_emails' или
'duplicate key value violates unique constraint'.
---
 app/admin/page.tsx                       | 20 ++++++++++++++++++--
 app/api/admin/allowlist/[email]/route.ts | 12 ++++++------
 app/api/admin/allowlist/route.ts         | 14 ++++++++------
 3 files changed, 32 insertions(+), 14 deletions(-)

diff --git a/app/admin/page.tsx b/app/admin/page.tsx
index b9566d3..d5f8bcb 100644
--- a/app/admin/page.tsx
+++ b/app/admin/page.tsx
@@ -95,7 +95,17 @@ export default function AdminPage() {
         body: JSON.stringify({ email: newEmail, note: newNote || null }),
       });
       const data = await res.json();
-      if (!res.ok) throw new Error(data.error ?? "Ошибка");
+      if (!res.ok) {
+        // data.error может быть строкой или объектом (например, от Supabase).
+        // Если объект — stringify, чтобы не получить [object Object] в UI.
+        const errMsg =
+          typeof data.error === "string"
+            ? data.error
+            : data.error
+            ? JSON.stringify(data.error)
+            : `HTTP ${res.status}`;
+        throw new Error(errMsg);
+      }
       setMsg(`✓ ${newEmail} добавлен в allowlist`);
       setNewEmail("");
       setNewNote("");
@@ -116,7 +126,13 @@ export default function AdminPage() {
     });
     const data = await res.json();
     if (!res.ok) {
-      setError(data.error ?? "Ошибка");
+      const errMsg =
+        typeof data.error === "string"
+          ? data.error
+          : data.error
+          ? JSON.stringify(data.error)
+          : `HTTP ${res.status}`;
+      setError(errMsg);
     } else {
       setMsg(`✓ ${email} удалён из allowlist`);
       await loadAllowlist();
diff --git a/app/api/admin/allowlist/[email]/route.ts b/app/api/admin/allowlist/[email]/route.ts
index e699dee..e420885 100644
--- a/app/api/admin/allowlist/[email]/route.ts
+++ b/app/api/admin/allowlist/[email]/route.ts
@@ -27,14 +27,14 @@ export async function DELETE(
       .delete()
       .eq("email", email);
 
-    if (deleteError) throw deleteError;
+    if (deleteError) {
+      throw new Error(deleteError.message || JSON.stringify(deleteError));
+    }
 
     return NextResponse.json({ ok: true });
   } catch (err) {
-    console.error("Admin allowlist delete error:", err instanceof Error ? err.message : String(err));
-    return NextResponse.json(
-      { error: err instanceof Error ? err.message : String(err) },
-      { status: 500 }
-    );
+    const errMsg = err instanceof Error ? err.message : String(err);
+    console.error("Admin allowlist delete error:", errMsg);
+    return NextResponse.json({ error: errMsg }, { status: 500 });
   }
 }
diff --git a/app/api/admin/allowlist/route.ts b/app/api/admin/allowlist/route.ts
index f98554f..9c9e4c4 100644
--- a/app/api/admin/allowlist/route.ts
+++ b/app/api/admin/allowlist/route.ts
@@ -81,14 +81,16 @@ export async function POST(req: NextRequest) {
       .select()
       .single();
 
-    if (insertError) throw insertError;
+    if (insertError) {
+      // Supabase возвращает ошибку как объект {message, code, details, hint}.
+      // Достаём message — это человекочитаемая строка.
+      throw new Error(insertError.message || JSON.stringify(insertError));
+    }
 
     return NextResponse.json({ ok: true, entry: data });
   } catch (err) {
-    console.error("Admin allowlist add error:", err instanceof Error ? err.message : String(err));
-    return NextResponse.json(
-      { error: err instanceof Error ? err.message : String(err) },
-      { status: 500 }
-    );
+    const errMsg = err instanceof Error ? err.message : String(err);
+    console.error("Admin allowlist add error:", errMsg);
+    return NextResponse.json({ error: errMsg }, { status: 500 });
   }
 }
