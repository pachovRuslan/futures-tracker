From e73af1276937e563314733d32afbcd8a60c33acd Mon Sep 17 00:00:00 2001
From: futures-tracker-fixes <dev@local>
Date: Thu, 30 Jul 2026 21:39:59 +0000
Subject: [PATCH] fix: env ALLOWED_EMAILS always works as fallback over DB
 allowlist
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

КРИТИЧЕСКИЙ БАГ: при добавлении email в админку пользователь терял
доступ, если его собственный email не был в БД allowed_emails.

Причина: старая логика middleware была:
  if (dbAllowlist.length > 0) {
    isAllowed = dbAllowlist.some(...);  // ТОЛЬКО БД
  } else {
    isAllowed = envAllowedEmails.includes(email);  // ТОЛЬКО env
  }

То есть, как только в БД появлялся ХОТЯ БЫ ОДИН email, env ALLOWED_EMAILS
полностью игнорировался. Если пользователь был в env, но не в БД —
он терял доступ.

Фикс — env ВСЕГДА работает как fallback поверх БД (объединение):
  let isAllowed = envAllowedEmails.includes(email);  // сначала env
  if (dbAllowlist.length > 0) {
    isAllowed = isAllowed || dbAllowlist.some(...);  // ИЛИ БД
  }

Теперь: email пускается, если он есть в env ИЛИ в БД. Это защищает
от случайной блокировки себя.

Также пофикшена ошибка 'Unexpected token <' в UI — loadAllowlist/loadUsers
теперь проверяют res.ok перед res.json(). Если middleware редиректнул
на /not-allowed и вернул HTML — показываем понятное сообщение вместо
JSON-парсинга.
---
 app/admin/page.tsx | 17 +++++++++++++++++
 middleware.ts      | 22 ++++++++++++----------
 2 files changed, 29 insertions(+), 10 deletions(-)

diff --git a/app/admin/page.tsx b/app/admin/page.tsx
index d5f8bcb..c1c9039 100644
--- a/app/admin/page.tsx
+++ b/app/admin/page.tsx
@@ -61,6 +61,16 @@ export default function AdminPage() {
   const loadAllowlist = useCallback(async () => {
     setLoading(true);
     const res = await fetch("/api/admin/allowlist");
+    // Если middleware нас редиректнул (например, на /not-allowed) —
+    // fetch возвращает HTML-страницу, а не JSON. Защищаемся от этого,
+    // чтобы не получить 'Unexpected token <' в UI.
+    if (!res.ok) {
+      const text = await res.text();
+      console.error("loadAllowlist failed:", res.status, text.slice(0, 200));
+      setError(`Не удалось загрузить allowlist (HTTP ${res.status})`);
+      setLoading(false);
+      return;
+    }
     const data = await res.json();
     setAllowlist(data.allowlist ?? []);
     setLoading(false);
@@ -69,6 +79,13 @@ export default function AdminPage() {
   const loadUsers = useCallback(async () => {
     setLoading(true);
     const res = await fetch("/api/admin/users");
+    if (!res.ok) {
+      const text = await res.text();
+      console.error("loadUsers failed:", res.status, text.slice(0, 200));
+      setError(`Не удалось загрузить пользователей (HTTP ${res.status})`);
+      setLoading(false);
+      return;
+    }
     const data = await res.json();
     setUsers(data.users ?? []);
     setLoading(false);
diff --git a/middleware.ts b/middleware.ts
index 52dad19..0c2bcaf 100644
--- a/middleware.ts
+++ b/middleware.ts
@@ -69,8 +69,12 @@ export async function middleware(request: NextRequest) {
   }
 
   // Allowlist из БД — основной источник.
-  // Если БД недоступна или таблица пуста — fallback на env ALLOWED_EMAILS.
-  let isAllowed = false;
+  // env ALLOWED_EMAILS ВСЕГДА работает как дополнительный fallback поверх БД.
+  // Это защищает от ситуации: вы добавили email в БД через админку,
+  // но забыли добавить свой собственный — и потеряли доступ.
+  // С этим фиксом env-allowlist продолжает пускать вас, даже если в БД
+  // вашего email-а нет.
+  let isAllowed = envAllowedEmails.includes(email);
   try {
     const { data: dbAllowlist, error } = await supabase
       .from("allowed_emails")
@@ -78,24 +82,22 @@ export async function middleware(request: NextRequest) {
     if (error) throw error;
 
     if (dbAllowlist && dbAllowlist.length > 0) {
-      isAllowed = dbAllowlist.some((row) => row.email.toLowerCase() === email);
-    } else {
-      // Таблица пуста — используем env как fallback.
-      isAllowed = envAllowedEmails.includes(email);
+      // БД не пуста — проверяем email и в БД, и в env (объединение).
+      // Если email есть в любом из источников — пускаем.
+      isAllowed =
+        isAllowed || dbAllowlist.some((row) => row.email.toLowerCase() === email);
     }
+    // Если БД пуста — остаётся только env (уже установлен в isAllowed).
   } catch (err) {
     console.error(
       "[middleware] Ошибка чтения allowed_emails из БД, fallback на env:",
       err instanceof Error ? err.message : String(err)
     );
-    isAllowed = envAllowedEmails.includes(email);
+    // isAllowed уже установлен из env выше — оставляем как есть.
   }
 
   // FAIL-CLOSED: если allowlist пуст (ни в БД, ни в env) — никого не пускаем.
-  // Раньше пустой список означал «открытый вход для любого Google-аккаунта».
   if (!isAllowed) {
-    // Дополнительная проверка: если allowlist вообще пуст — показываем
-    // понятную ошибку. Иначе — обычный /not-allowed.
     return NextResponse.redirect(new URL("/not-allowed", request.url));
   }
 
-- 
