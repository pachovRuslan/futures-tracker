+// ============================================================
+// getCronSyncDays — окно инкрементального cron-синка
+// ============================================================
+
+/**
+ * Cron-синк тянет только последние N дней (env CRON_SYNC_DAYS,
+ * по умолчанию 7). Причина: полный год по ВСЕМ юзерам — это сотни
+ * последовательных HTTP-запросов к бирже (bybit: ~52 семидневных
+ * окна × 8 подключений), которые НЕ влезают в maxDuration=60 на
+ * Hobby-плане → Vercel убивает функцию (FUNCTION_INVOCATION_TIMEOUT).
+ *
+ * Ручной синк (кнопка «Синк всё» на сайте / «Синк все биржи» в
+ * приложении) работает в user-режиме с ОДНИМ юзером и продолжает
+ * тянуть 365 дней — это ~15-25 секунд, в лимит влезает. Первичное
+ * наполнение истории при добавлении нового подключения происходит
+ * именно ручной кнопкой, крон только поддерживает свежесть.
+ *
+ * Окно 7 дней самовосстанавливается: если крон пропустил до 6 ночей
+ * подряд (деплой, даунтайм), следующая ночь доберёт всё пропущенное —
+ * upsert по (user_id, exchange, external_id) идемпотентен.
+ */
+export function getCronSyncDays(): number {
+  const n = Number(process.env.CRON_SYNC_DAYS ?? "7");
+  return Number.isFinite(n) && n >= 1 ? Math.floor(n) : 7;
+}
