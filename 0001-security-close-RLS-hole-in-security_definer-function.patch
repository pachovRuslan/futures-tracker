 lib/admin.ts                                  |  52 +++--
 middleware.ts                                 |  34 ++-
 .../migration_08_admin_rls_protection.sql     | 203 ++++++++++++++++++
 3 files changed, 263 insertions(+), 26 deletions(-)
 create mode 100644 supabase/migration_08_admin_rls_protection.sql

