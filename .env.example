# Supabase — серверный доступ (service_role, обходит RLS, только для API-роутов синка)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Supabase — публичные ключи для Auth (браузер + middleware). Project URL тот же,
# что и SUPABASE_URL выше. Publishable key берётся в Settings -> API Keys.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Список email-адресов через запятую, которым разрешён вход через Google.
ALLOWED_EMAILS=

# UUID твоего аккаунта в auth.users (Supabase Dashboard -> Authentication ->
# Users -> колонка "UID" напротив твоего email) — сделки с синка биржи будут
# приписаны этому пользователю. Обязателен после миграции 2 (RLS/user_id).
SYNC_USER_ID=

# Bybit (read-only ключ!)
BYBIT_API_KEY=
BYBIT_API_SECRET=

# Bitunix (read-only ключ!)
BITUNIX_API_KEY=
BITUNIX_API_SECRET=
# Список торгуемых символов через запятую — можно оставить пустым, тогда синк
# пойдёт по всем символам сразу (см. README)
BITUNIX_SYMBOLS=
