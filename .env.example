# Supabase — серверный доступ (service_role, обходит RLS, только для API-роутов синка)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Supabase — публичные ключи для Auth (браузер + middleware). Project URL тот же,
# что и SUPABASE_URL выше. Publishable key берётся в Settings -> API Keys.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Список email-адресов через запятую, которым разрешён вход через Google.
ALLOWED_EMAILS=

# UUID твоего аккаунта в auth.users (Supabase Dashboard -> Authentication ->
# Users -> колонка "UID" напротив твоего email).
#
# С шагом 4 (мультитенантный синк) эта переменная БОЛЬШЕ НЕ ИСПОЛЬЗУЕТСЯ —
# cron сам обходит ВСЕ строки exchange_connections и синкает каждого
# пользователя с его собственным user_id. Ручной запуск с дашборда тоже
# использует сессию текущего юзера, а не эту переменную.
#
# Оставлено в файле только для обратной совместимости со старыми деплоями —
# можно не заполнять. Удалять из Vercel env не критично, но и не нужно.
SYNC_USER_ID=

# Ключ шифрования API-ключей бирж перед записью в БД. 32 байта в base64.
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# НЕ ТЕРЯЙ этот ключ и НЕ МЕНЯЙ его после того, как уже сохранил подключения —
# без него сохранённые ключи бирж невозможно расшифровать.
ENCRYPTION_KEY=

# API-ключи бирж теперь вводятся через UI (страница "Подключения") и хранятся
# зашифрованными в БД — сюда их вписывать больше не нужно.
# Для бирж с ключ+secret+passphrase (Bitget) passphrase тоже вводится в UI.

# Список торгуемых символов Bitunix через запятую — можно оставить пустым,
# тогда синк пойдёт по всем символам сразу (см. README)
BITUNIX_SYMBOLS=

# Секрет для авторизации cron-запросов к /api/sync/*.
# Vercel автоматически шлёт заголовок `Authorization: Bearer $CRON_SECRET`
# при запуске cron-задач, если эта переменная задана. Без неё sync-роуты
# были бы публичными — любой, кто знает URL, мог дёргать синк и забивать
# rate-limit биржи.
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Оставь пустым ТОЛЬКО для локальной разработки (на проде обязателен).
CRON_SECRET=
