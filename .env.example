# Supabase — серверный доступ (service_role, обходит RLS, только для API-роутов синка)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Supabase — публичные ключи для Auth (браузер + middleware). Project URL тот же,
# что и SUPABASE_URL выше. Publishable key берётся в Settings -> API Keys.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Список email-адресов через запятую, которым разрешён вход через Google.
ALLOWED_EMAILS=

# UUID твоего аккаунта в auth.users (Supabase Dashboard -> Authentication ->
# Users -> колонка "UID" напротив твоего email) — сделки с синка биржи будут
# приписаны этому пользователю.
SYNC_USER_ID=

# Ключ шифрования API-ключей бирж перед записью в БД. 32 байта в base64.
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# НЕ ТЕРЯЙ этот ключ и НЕ МЕНЯЙ его после того, как уже сохранил подключения —
# без него сохранённые ключи бирж невозможно расшифровать.
ENCRYPTION_KEY=

# API-ключи бирж теперь вводятся через UI (страница "Подключения") и хранятся
# зашифрованными в БД — сюда их вписывать больше не нужно.

# Список торгуемых символов Bitunix через запятую — можно оставить пустым,
# тогда синк пойдёт по всем символам сразу (см. README)
BITUNIX_SYMBOLS=
